FROM python:{{ python_version }}-slim AS development

COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

RUN apt-get update --yes --quiet \
    && apt-get install --yes --quiet --no-install-recommends \
        build-essential{% if build_database_packages %} {{ build_database_packages }}{% endif %} \
        libjpeg62-turbo-dev zlib1g-dev libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project

COPY . .

ENV DJANGO_SETTINGS_MODULE={{ settings_module }}.dev

CMD ["uv", "run", "python", "manage.py", "runserver", "0.0.0.0:8000"]
