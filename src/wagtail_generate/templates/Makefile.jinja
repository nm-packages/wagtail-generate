.DEFAULT_GOAL := help

.PHONY: help sync{% if database != "sqlite3" %} database{% endif %} migrate dev docker stop superuser lint test check

help: ## Show the available commands
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z_-]+:.*## / {printf "  %-12s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

sync: ## Install the locked Python dependencies
	uv sync
{% if database != "sqlite3" %}
database: ## Start the local database container
	docker compose up -d --wait db
{% endif %}
migrate: ## Apply Django database migrations
	uv run python manage.py migrate

dev: ## Run Wagtail locally
{% if database != "sqlite3" %}	docker compose up -d --wait db
{% endif %}	uv sync
	uv run python manage.py migrate
	uv run python manage.py runserver

docker: ## Build and run the complete development environment
	docker compose up --build

stop: ## Stop the development containers
	docker compose down

superuser: ## Create a Wagtail administrator locally
	uv run python manage.py createsuperuser

lint: ## Check Python and Django-template formatting
	uv run ruff check .
	uv run ruff format --check .
	uv run djangofmt --check .

test: ## Run the Django test suite
	uv run python manage.py test

check: lint test ## Run all quality checks
